PORT=3000
DATABASE_PATH=./data/capyhome.sqlite
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
# Generate a SHA-256 hash with: printf '%s' 'your-password' | sha256sum | cut -d' ' -f1
# Paste the 64-character hex digest below. Plaintext passwords are rejected.
ADMIN_PASSWORD=replace-with-a-sha256-password-hash
TZ=Europe/Rome
# Set to true behind HTTPS; leave false for local HTTP.
COOKIE_SECURE=false
# Set to 1 only when directly behind a trusted reverse proxy.
TRUST_PROXY=0
